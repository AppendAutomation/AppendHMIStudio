{
  "name": "append-hmi-studio",
  "productName": "Append HMI Studio",
  "version": "1.0.0",
  "description": "Append HMI Studio: design, run and publish HMI applications for PLCs",
  "exports": "./src/main/electron.js",
  "type": "module",
  "main": "src/main/electron.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "build-comms": "node comms/scripts/publish.mjs",
    "test-comms": "dotnet test comms/HmiComms.sln",
    "fetch-nsis": "node scripts/fetch-nsis.mjs",
    "build-win-runtime": "node scripts/build-win-runtime.mjs",
    "test": "node --test src/test/cli-args.test.js src/test/window-bounds.test.js src/test/comms-supervisor.test.js src/test/comms-session.test.js src/test/publish-packaging.test.js src/test/runtime-mode.test.js src/test/publish.test.js src/test/brand.test.js src/test/alarm-log.test.js src/test/hmi-cli.test.js src/test/retentive-store.test.js src/test/user-store.test.js",
    "make-icons": "node scripts/make-icons.mjs",
    "dist-win": "node scripts/dist-win.mjs",
    "dist-linux": "node scripts/dist-linux.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AppendAutomation/AppendHMIStudio.git"
  },
  "keywords": [
    "HMI",
    "SCADA",
    "PLC",
    "EtherNet/IP",
    "Modbus"
  ],
  "author": "Append Automation <dhuntlinux@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/AppendAutomation/AppendHMIStudio/issues"
  },
  "homepage": "https://github.com/AppendAutomation/AppendHMIStudio",
  "dependencies": {
    "@cantoo/pdf-lib": "^2.7.3",
    "buffer": "^6.0.3",
    "compression": "^1.8.1",
    "crc": "^4.3.2",
    "electron-context-menu": "^5.0.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "resedit": "^1.7.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.7",
    "sumchecker": "^3.0.1"
  }
}
