    <recipeBooks>
      <recipeBook name="Plasticizer Blends" uploadDownload="1">
        <recipeItem tag="Edit_TotalVol" ioTag="Rcp_TotalVol" />
        <recipeItem tag="Edit_Pct0" ioTag="Rcp_Pct0" />
        <recipeItem tag="Edit_Pct1" ioTag="Rcp_Pct1" />
        <recipeItem tag="Edit_Pct2" ioTag="Rcp_Pct2" />
        <recipeData name="Standard Blend">
          <recipeValue tag="Edit_TotalVol" value="10" number="1" />
          <recipeValue tag="Edit_Pct0" value="60" number="1" />
          <recipeValue tag="Edit_Pct1" value="25" number="1" />
          <recipeValue tag="Edit_Pct2" value="15" number="1" />
        </recipeData>
        <recipeData name="High Plasticizer">
          <recipeValue tag="Edit_TotalVol" value="10" number="1" />
          <recipeValue tag="Edit_Pct0" value="70" number="1" />
          <recipeValue tag="Edit_Pct1" value="20" number="1" />
          <recipeValue tag="Edit_Pct2" value="10" number="1" />
        </recipeData>
        <recipeData name="Hose Compound">
          <recipeValue tag="Edit_TotalVol" value="9" number="1" />
          <recipeValue tag="Edit_Pct0" value="45" number="1" />
          <recipeValue tag="Edit_Pct1" value="35" number="1" />
          <recipeValue tag="Edit_Pct2" value="20" number="1" />
        </recipeData>
        <recipeData name="Low Odor">
          <recipeValue tag="Edit_TotalVol" value="8" number="1" />
          <recipeValue tag="Edit_Pct0" value="50" number="1" />
          <recipeValue tag="Edit_Pct1" value="50" number="1" />
          <recipeValue tag="Edit_Pct2" value="0" number="1" />
        </recipeData>
        <recipeData name="Trial Batch">
          <recipeValue tag="Edit_TotalVol" value="4" number="1" />
          <recipeValue tag="Edit_Pct0" value="40" number="1" />
          <recipeValue tag="Edit_Pct1" value="30" number="1" />
          <recipeValue tag="Edit_Pct2" value="30" number="1" />
        </recipeData>
