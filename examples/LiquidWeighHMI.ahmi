      <window page="H5nWZ7pqdWC377nCGU_m" titleBar="1" type="popup" x="730" y="150" width="460" height="560" everyMs="250">
        <onShow>
          { Points the faceplate's indirect tags at the tags of the device
  the opening button chose: FP_Prefix + "_Status" is SV100_Status, ... }
LinkIndirectTag("FP_Status", FP_Prefix + "_Status");
LinkIndirectTag("FP_Manual", FP_Prefix + "_Manual");
LinkIndirectTag("FP_CmdAuto", FP_Prefix + "_CmdAuto");
LinkIndirectTag("FP_CmdManual", FP_Prefix + "_CmdManual");
LinkIndirectTag("FP_Cmd", FP_Prefix + "_Cmd");
LinkIndirectTag("FP_Perm", FP_Prefix + "_Perm");
LinkIndirectTag("FP_Fault", FP_Prefix + "_Fault");
IF FP_IsPump THEN
    LinkIndirectTag("FP_CmdOn", FP_Prefix + "_CmdStart");
    LinkIndirectTag("FP_CmdOff", FP_Prefix + "_CmdStop");
    LinkIndirectTag("FP_Running", FP_Prefix + "_Running");
    LinkIndirectTag("FP_HandRun", FP_Prefix + "_HandRun");
    LinkIndirectTag("FP_Time", FP_Prefix + "_FailTime");
ELSE
    LinkIndirectTag("FP_CmdOn", FP_Prefix + "_CmdOpen");
    LinkIndirectTag("FP_CmdOff", FP_Prefix + "_CmdClose");
    LinkIndirectTag("FP_FltOpen", FP_Prefix + "_FltOpen");
    LinkIndirectTag("FP_FltClose", FP_Prefix + "_FltClose");
    LinkIndirectTag("FP_Time", FP_Prefix + "_TravelTime");
    IF FP_HasLimits THEN
        LinkIndirectTag("FP_ZSO", FP_Prefix + "_ZSO");
        LinkIndirectTag("FP_ZSC", FP_Prefix + "_ZSC");
    ENDIF;
ENDIF;
{ The status in words, for the status box }
IF FP_IsPump THEN
    IF FP_Status == 0 THEN FP_StateText = "STOPPED"; ENDIF;
    IF FP_Status == 1 THEN FP_StateText = "RUNNING"; ENDIF;
    IF FP_Status == 2 THEN FP_StateText = "STARTING"; ENDIF;
    IF FP_Status == 3 THEN FP_StateText = "FAULT"; ENDIF;
    IF FP_Status == 4 THEN FP_StateText = "RUNNING - HAND"; ENDIF;
ELSE
    IF FP_Status == 0 THEN FP_StateText = "CLOSED"; ENDIF;
    IF FP_Status == 1 THEN FP_StateText = "OPEN"; ENDIF;
    IF FP_Status == 2 THEN FP_StateText = "TRAVELLING"; ENDIF;
    IF FP_Status == 3 THEN FP_StateText = "FAULT"; ENDIF;
ENDIF;
        </onShow>
        <whileShowing>
          { The status in words, for the status box }
IF FP_IsPump THEN
    IF FP_Status == 0 THEN FP_StateText = "STOPPED"; ENDIF;
    IF FP_Status == 1 THEN FP_StateText = "RUNNING"; ENDIF;
    IF FP_Status == 2 THEN FP_StateText = "STARTING"; ENDIF;
    IF FP_Status == 3 THEN FP_StateText = "FAULT"; ENDIF;
    IF FP_Status == 4 THEN FP_StateText = "RUNNING - HAND"; ENDIF;
ELSE
    IF FP_Status == 0 THEN FP_StateText = "CLOSED"; ENDIF;
    IF FP_Status == 1 THEN FP_StateText = "OPEN"; ENDIF;
    IF FP_Status == 2 THEN FP_StateText = "TRAVELLING"; ENDIF;
    IF FP_Status == 3 THEN FP_StateText = "FAULT"; ENDIF;
ENDIF;
        </whileShowing>
      </window>
